{
  "name": "url-shortener",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:utm": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-utm.mjs",
    "check:invisible": "node scripts/check-invisible.mjs",
    "check:bio": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-bio.mjs",
    "check:notifications": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-notifications.mjs",
    "check:api-keys": "node scripts/check-invisible.mjs && TZ=UTC node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api-keys.mjs && TZ=America/Los_Angeles node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api-keys.mjs && TZ=Pacific/Auckland node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api-keys.mjs",
    "check:share": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-share.mjs",
    "check:country-map": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-country-map.mjs",
    "check:domains": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-domains.mjs",
    "check:moderation": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-moderation.mjs",
    "check:inspection": "node scripts/check-invisible.mjs && TZ=UTC node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-inspection.mjs && TZ=America/Los_Angeles node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-inspection.mjs && TZ=Pacific/Auckland node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-inspection.mjs",
    "check:system-status": "node scripts/check-invisible.mjs && TZ=UTC node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-system-status.mjs && TZ=America/Los_Angeles node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-system-status.mjs && TZ=Pacific/Auckland node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-system-status.mjs",
    "check:landing-visits": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-landing-visits.mjs",
    "check:claim": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-claim.mjs",
    "check:worker": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-worker.mjs",
    "check:stale-chunk": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-stale-chunk.mjs",
    "check:reconnecting": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-reconnecting.mjs",
    "check:connect": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-connect.mjs",
    "check:oauth-challenge": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-oauth-challenge.mjs",
    "check:link-edit": "node scripts/check-invisible.mjs && TZ=UTC node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-link-edit.mjs && TZ=America/Los_Angeles node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-link-edit.mjs && TZ=Pacific/Auckland node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-link-edit.mjs",
    "check:session-check": "node scripts/check-invisible.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-session-check.mjs",
    "check:api-client": "node scripts/check-invisible.mjs && NODE_ENV=production node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api-client.mjs",
    "check:live": "node scripts/check-invisible.mjs && NODE_ENV=production node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-live.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.2",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
